<Window x:Class="BlinkObserverTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Blink Observer Tool"
        Height="980"
        Width="1400"
        MinHeight="760"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="保存済み設定">
                    <StackPanel Margin="8">
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="設定一覧" />
                            <ComboBox x:Name="ConfigurationComboBox"
                                      Grid.Column="1"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="ConfigurationComboBox_SelectionChanged" />
                            <Button Grid.Column="2" Margin="8,0,0,0" Padding="8,4" Click="ReloadConfigurations_Click" Content="一覧更新" />
                        </Grid>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="設定名" />
                            <TextBox x:Name="ConfigurationNameTextBox" TextChanged="ConfigurationInput_Changed" Grid.Column="1" />
                        </Grid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Margin="0,0,8,8" Padding="10,6" Click="SaveConfiguration_Click" Content="設定保存" />
                            <Button Margin="0,0,8,8" Padding="10,6" Click="DeleteConfiguration_Click" Content="設定削除" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="自動認識プロファイル" Margin="0,8,0,0">
                    <StackPanel Margin="8">
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="使用プロファイル" />
                            <ComboBox x:Name="ProfileComboBox"
                                      Grid.Column="1"
                                      ItemsSource="{Binding AvailableProfiles}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedProfileEntry}"
                                      SelectionChanged="ProfileComboBox_SelectionChanged" />
                            <Button Grid.Column="2" Margin="8,0,0,0" Padding="8,4" Click="ReloadProfileList_Click" Content="一覧更新" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#B35A00"
                                   Text="{Binding ProfileLoadHint}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="BlinkModelStatusTextBlock"
                                   Margin="0,4,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="#B35A00"
                                   Text="モデル状態: プロファイルを読み込んでください。"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#555555"
                                   Text="固定テンプレート瞬き認識は専用セットアップで ROI、開眼、閉眼を順に採取します。テンプレートマッチング等の詳細設定は自動認識設定を使用してください。"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Margin="0,0,8,8" Padding="10,6" Click="LoadProfile_Click" Content="プロファイル読込" />
                            <Button Margin="0,0,8,8" Padding="10,6" Click="StartObservation_Click" Content="観測開始" />
                            <Button Margin="0,0,8,8" Padding="10,6" Click="StopObservation_Click" IsEnabled="{Binding IsRunning}" Content="観測停止" />
                            <Button Margin="0,0,8,8" Padding="10,6" Click="OpenBlinkSetup_Click" Content="瞬き観測セットアップ" />
                            <Button Margin="0,0,8,8" Padding="10,6" Click="OpenDetailedSettings_Click" Content="自動認識設定を開く" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="観測モード" Margin="0,8,0,0">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="KeySendModeRadioButton"
                                         GroupName="ObservationMode"
                                         Margin="0,0,16,0"
                                         IsChecked="True"
                                         Checked="ObservationModeRadioButton_Checked"
                                         Content="瞬き計算ツールへ入力" />
                            <RadioButton x:Name="VerificationModeRadioButton"
                                         GroupName="ObservationMode"
                                         Checked="ObservationModeRadioButton_Checked"
                                         Content="検証のみ (ログ / 通知音)" />
                        </StackPanel>
                        <TextBlock x:Name="ObservationModeHintTextBlock"
                                   Margin="0,6,0,0"
                                   Foreground="#555555"
                                   Text="検証のみモードではキー送信せず、瞬き検出の記録と任意の通知音だけを行います。"
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="VerificationOptionsPanel" Margin="0,8,0,0">
                            <CheckBox x:Name="VerificationSoundCheckBox"
                                      Checked="VerificationNotificationSetting_Changed"
                                      Unchecked="VerificationNotificationSetting_Changed"
                                      Content="検証時に瞬き検出音を鳴らす" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="通知音" />
                                <ComboBox x:Name="VerificationSoundComboBox"
                                          Grid.Column="1"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="VerificationNotificationSetting_Changed" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="KeySendSettingsGroupBox" Header="キー送信設定" Margin="0,8,0,0">
                    <StackPanel Margin="8">
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="送信キー" />
                            <ComboBox x:Name="SendKeyComboBox"
                                      Grid.Column="1"
                                      DisplayMemberPath="Label"
                                      SelectionChanged="ConfigurationInput_Changed" />
                            <Button Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Padding="8,4"
                                    Click="CaptureSendKey_Click"
                                    Content="押下から設定" />
                        </Grid>
                        <TextBlock x:Name="CaptureSendKeyStatusTextBlock"
                                   Margin="0,0,0,6"
                                   Foreground="#555555"
                                   Text="送信キーを手動選択できます。" />
                        <CheckBox x:Name="SendModifierAsCommonKeyCheckBox"
                                  Margin="0,0,0,6"
                                  Checked="ConfigurationInput_Changed"
                                  Unchecked="ConfigurationInput_Changed"
                                  Content="Shift / Ctrl / Alt は左右別ではなく共通キーとして送る" />
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="送信方式" />
                            <ComboBox x:Name="SendModeComboBox"
                                      Grid.Column="1"
                                      DisplayMemberPath="Label"
                                      SelectionChanged="ConfigurationInput_Changed" />
                            <Button Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Padding="8,4"
                                    Click="InstallPhysicalDriver_Click"
                                    Content="物理入力ドライバ導入" />
                        </Grid>
                        <TextBlock x:Name="DriverStatusTextBlock"
                                   Margin="0,0,0,6"
                                   Foreground="#555555"
                                   Text="ドライバ状態: 未確認" />
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="送信契機" />
                            <ComboBox x:Name="SendTriggerComboBox"
                                      Grid.Column="1"
                                      DisplayMemberPath="Label"
                                      SelectionChanged="ConfigurationInput_Changed" />
                        </Grid>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="押下時間(ms)" />
                            <TextBox x:Name="KeyHoldMillisecondsTextBox" Grid.Column="1" TextChanged="ConfigurationInput_Changed" />
                        </Grid>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="対象プロセス名" />
                            <TextBox x:Name="TargetProcessNameTextBox" Grid.Column="1" TextChanged="ConfigurationInput_Changed" />
                        </Grid>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="対象ウィンドウ名" />
                            <TextBox x:Name="TargetWindowTitleTextBox" Grid.Column="1" TextChanged="ConfigurationInput_Changed" />
                        </Grid>
                        <CheckBox x:Name="BringToFrontCheckBox"
                                  Margin="0,6,0,0"
                                  IsChecked="True"
                                  Checked="ConfigurationInput_Changed"
                                  Unchecked="ConfigurationInput_Changed"
                                  Content="送信前に対象ウィンドウを前面化する" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="同一瞬きとしてまとめる回数" TextWrapping="Wrap" />
                            <TextBox x:Name="RequiredBlinkCountTextBox" Grid.Column="1" TextChanged="ConfigurationInput_Changed" />
                        </Grid>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="瞬き集約時間(ms)" />
                            <TextBox x:Name="BlinkAggregationWindowTextBox" Grid.Column="1" TextChanged="ConfigurationInput_Changed" />
                        </Grid>
                        <TextBlock Margin="140,0,0,0"
                                   Foreground="#555555"
                                   Text="1回目の瞬きで送信し、この時間内の追加検出は同一瞬きとして無視します。"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="WindowCandidatesComboBox" DisplayMemberPath="DisplayName" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="8,4" Click="RefreshWindowCandidates_Click" Content="候補更新" />
                        </Grid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Margin="0,0,8,8" Padding="10,6" Click="ApplyWindowCandidate_Click" Content="候補を反映" />
                            <Button Margin="0,0,8,8" Padding="10,6" Click="SendTestKey_Click" Content="送信テスト" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12" BorderBrush="#22000000" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="{Binding StatusMessage}" />
                    <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#B35A00" Text="{Binding OperationStatusText}" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding LatestDetection}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding LatestText}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#555555"
                               Text="認識表示: blink-unknown=判定不能（イベント抑止）、blink-reacquiring=連続開眼確認中"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="観測動作状態" />
                    <TextBlock x:Name="KeySendStatusTextBlock" Text="待機中" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="現在の設定" />
                    <TextBlock x:Name="CurrentConfigurationTextBlock" Text="未選択" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Margin="0,12,0,12" BorderBrush="#22000000" BorderThickness="1" CornerRadius="4">
                <Grid Background="#11000000">
                    <Image x:Name="PreviewImageControl" Source="{Binding PreviewImage}" Stretch="Uniform" MouseMove="PreviewImage_MouseMove" MouseLeave="PreviewImage_MouseLeave" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#99000000" Text="{Binding Localization[Preview], Mode=OneWay}" />
                </Grid>
            </Border>

            <GroupBox Grid.Row="2" Header="本体ログ">
                <ListBox x:Name="ToolLogListBox" Margin="8" />
            </GroupBox>
        </Grid>
    </Grid>
</Window>
