<Window x:Class="BlinkObserverTool.BlinkRecognition.BlinkSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="瞬き観測セットアップ"
        Width="1040"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="観測する目をドラッグして囲んでください" />
            <TextBlock Margin="0,4,0,8"
                       Foreground="#555555"
                       Text="プレビューがない場合は取得ボタンを押します。選択後は開眼状態を自動学習するため、観測開始直後は目を開けたままにしてください。"
                       TextWrapping="Wrap" />
            <Button Width="150"
                    HorizontalAlignment="Left"
                    Padding="10,6"
                    Click="CapturePreview_Click"
                    Content="最新プレビューを取得" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,10" BorderBrush="#44000000" BorderThickness="1" Background="#11000000">
            <Grid x:Name="PreviewSurface"
                  Background="Transparent"
                  MouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown"
                  MouseMove="PreviewSurface_MouseMove"
                  MouseLeftButtonUp="PreviewSurface_MouseLeftButtonUp">
                <Image x:Name="PreviewImage" Source="{Binding PreviewImage}" Stretch="Uniform" IsHitTestVisible="False" />
                <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                    <Rectangle x:Name="SelectionRectangle"
                               Visibility="Collapsed"
                               Stroke="#FFFF3B30"
                               StrokeThickness="2"
                               Fill="#22FF3B30" />
                </Canvas>
            </Grid>
        </Border>
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   FontWeight="SemiBold"
                   Foreground="#B35A00"
                   Text="プレビューを取得して目を選択してください。"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
