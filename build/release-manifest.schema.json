{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/p-o-ke-nae/BlinkObserverTool/blob/main/build/release-manifest.schema.json",
  "title": "BlinkObserverTool release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tag",
    "product",
    "architecture",
    "minimumWindowsVersion",
    "installerFilename",
    "sha256",
    "publishedAt",
    "releaseUrl"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "product": {
      "const": "BlinkObserverTool"
    },
    "architecture": {
      "const": "x64"
    },
    "minimumWindowsVersion": {
      "type": "string",
      "pattern": "^10\\.0(?:\\.[0-9]+(?:\\.[0-9]+)?)?$"
    },
    "installerFilename": {
      "const": "BlinkObserverTool.Installer.msi"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "releaseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/p-o-ke-nae/BlinkObserverTool/releases/tag/v[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
